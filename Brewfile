# Brewfile — declarative package list for dev terminal setup
# Usage: brew bundle
# All installs are idempotent — safe to re-run at any time

# ── CLI tools ────────────────────────────────────────────────────────────────

# asdf — multi-language version manager (node, ruby, python, etc.)
brew "asdf"

# tmux — terminal session and window/pane manager
brew "tmux"

# starship — cross-shell prompt with pure preset styling
brew "starship"

# zoxide — smart cd replacement with frecency-based directory jumping
brew "zoxide"

# zsh-autosuggestions — inline history-based suggestions as you type
brew "zsh-autosuggestions"

# zsh-syntax-highlighting — real-time syntax coloring for zsh commands
brew "zsh-syntax-highlighting"

# ── Fonts ────────────────────────────────────────────────────────────────────

# JetBrains Mono Nerd Font — required for starship icons and glyphs to render
cask "font-jetbrains-mono-nerd-font"

# ── Terminal emulator ────────────────────────────────────────────────────────

# Ghostty — the terminal emulator in use
cask "ghostty"
